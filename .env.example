# Neon Postgres — whale-tracker project (delicate-truth-19936801). Named WHALE_* on purpose:
# DATABASE_URL in the shared environment points at the ArbScout DB.
WHALE_DATABASE_URL=postgres://user:pass@host/neondb?sslmode=require
# 'pg' (TCP 5432, default) or 'neon-ws' (WebSockets over 443, when 5432 is blocked)
WHALE_DB_DRIVER=pg

# Kalshi — public REST needs no auth; keys are used for the live WebSocket (step 3)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=

# Polymarket US (Ed25519) — used for the live WebSocket (step 3)
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Backfill tuning
KALSHI_REQ_PER_SEC=8
# Trades smaller than this (USD notional) are counted in histograms but not stored row-by-row
MIN_STORE_USD=500
