[Unit]
Description=whale-tracker live collector (Kalshi + PM.US trade streams)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=whale
WorkingDirectory=/opt/whale-tracker/apps/collector
EnvironmentFile=/etc/whale-tracker.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/whale-tracker/node_modules/.bin/tsx src/live.ts
Restart=always
RestartSec=10
# SIGTERM → collector flushes buffered trades/whale orders before exiting
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:/var/log/whale-tracker/live.log
StandardError=append:/var/log/whale-tracker/live.log

[Install]
WantedBy=multi-user.target
